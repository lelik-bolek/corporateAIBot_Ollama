        <mxCell id="30cM84ZlsujOVSpiJzuU-10" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#333333;size=14;align=center;verticalAlign=top;spacingTop=4;metaEdit=1;" value="&lt;b&gt;JSON Lines Payload Structure&lt;/b&gt;&lt;hr&gt;&lt;div style=&quot;text-align: left; font-size: 9px; font-family: monospace;&quot;&gt;{&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;request_id&quot;: &quot;uuid4&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;timestamp&quot;: &quot;2026-08-31T...&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;app_version&quot;: &quot;v3&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;query&quot;: &quot;...&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;security_mode&quot;: &quot;full&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;security_triggered&quot;: false,&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;retrieved_chunks&quot;: [{&quot;source_file&quot;, &quot;score&quot;}],&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;response&quot;: &quot;...&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;chain_of_thought&quot;: &quot;...&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;confidence_score&quot;: 0.89,&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;is_known&quot;: true,&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;metrics&quot;: {&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;retrieval_latency_ms&quot;: 14.2,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;llm_latency_ms&quot;: 310.5,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;total_latency_ms&quot;: 325.8&lt;br&gt;&amp;nbsp;&amp;nbsp;}&lt;br&gt;}&lt;/div&gt;" vertex="1">
