        <object placeholders="1" c4Name="Продуктовый слепок (eval_runs_v3.jsonl)" c4Type="JSON Lines Storage" c4Technology="logs/eval/eval_runs_v3.jsonl" c4Description="Потоковая дозапись (append-only) полных срезов взаимодействия для анализа качества RAG" label="&lt;font style=&quot;font-size: 14px&quot;&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%: %c4Technology%]&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align: left; font-size: 10px;&quot;&gt;• 1 строка = 1 JSON-слепок запроса&lt;br&gt;• Дозапись без чтения файла с диска&lt;br&gt;• Чтение: pd.read_json(..., lines=True)&lt;/div&gt;" id="30cM84ZlsujOVSpiJzuU-9">
          <mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#1061B0;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0D5091;metaEdit=1;resizable=0;" vertex="1">
