        </object>
        <object placeholders="1" c4Name="System Logger" c4Type="Component (Synchronous)" c4Technology="src/utils/logger.py" c4Description="RotatingFileHandler (10 МБ, 5 копий) + stdout. Фиксирует старт, шаги пайплайна, [Security Alert] и ошибки 500" label="&lt;font style=&quot;font-size: 14px&quot;&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%: %c4Technology%]&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align: left; font-size: 10px;&quot;&gt;• Уровни: INFO, WARNING, ERROR&lt;br&gt;• Формат: %(asctime)s | %(levelname)s | %(message)s&lt;br&gt;• Trace-ID во всех записях и Stack Trace&lt;/div&gt;" id="30cM84ZlsujOVSpiJzuU-4">
          <mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#28A745;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#1E7E34;metaEdit=1;resizable=0;" vertex="1">
            <mxGeometry height="120" width="310" x="320" y="420" as="geometry" />
          </mxCell>
        </object>
        <object placeholders="1" c4Name="EvalLogger (BackgroundTasks)" c4Type="Component (Asynchronous)" c4Technology="src/evaluation/logger.py" c4Description="FastAPI BackgroundTasks: асинхронный сброс JSON Lines после отправки HTTP 200 клиенту" label="&lt;font style=&quot;font-size: 14px&quot;&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%: %c4Technology%]&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align: left; font-size: 10px;&quot;&gt;• Метод: log_interaction(payload)&lt;br&gt;• Режим: mode=&#39;a&#39; (Append-only)&lt;br&gt;• Версионирование: eval_runs_{version}.jsonl&lt;/div&gt;" id="30cM84ZlsujOVSpiJzuU-5">
          <mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#28A745;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#1E7E34;metaEdit=1;resizable=0;" vertex="1">
