        <object placeholders="1" c4Name="FastAPI Controller &amp; Middleware" c4Type="Component" c4Technology="src/bot.py" c4Description="Генерация X-Trace-ID, замер полного времени ответа и маршрутизация логирования" label="&lt;font style=&quot;font-size: 14px&quot;&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%: %c4Technology%]&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align: left; font-size: 10px;&quot;&gt;• TraceRequestsMiddleware: X-Trace-ID&lt;br&gt;• Эндпоинты: POST /ask, GET /health&lt;br&gt;• Диспетчеризация BackgroundTasks&lt;/div&gt;" id="30cM84ZlsujOVSpiJzuU-3">
          <mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#1061B0;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0D5091;metaEdit=1;resizable=0;" vertex="1">
            <mxGeometry height="110" width="320" x="500" y="200" as="geometry" />
