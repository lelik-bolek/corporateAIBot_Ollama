        <object placeholders="1" c4Name="Module: src/security/filters.py" c4Type="Code Boundary" c4Application="Python Submodule" label="&lt;font style=&quot;font-size: 16px&quot;&gt;&lt;b&gt;&lt;div style=&quot;text-align: left&quot;&gt;%c4Name%&lt;/div&gt;&lt;/b&gt;&lt;/font&gt;&lt;div style=&quot;text-align: left&quot;&gt;[%c4Application%]&lt;/div&gt;" id="9ycdJjKQUusQKeJaiFWU-2">
          <mxCell parent="1" style="rounded=1;fontSize=11;whiteSpace=wrap;html=1;dashed=1;arcSize=10;fillColor=none;strokeColor=#C0392B;strokeWidth=1.5;fontColor=#962D22;labelBackgroundColor=none;align=left;verticalAlign=bottom;labelBorderColor=none;spacingTop=0;spacing=10;dashPattern=8 4;metaEdit=1;pointerEvents=0;absoluteArcSize=1;" vertex="1">
