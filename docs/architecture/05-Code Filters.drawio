        <object placeholders="1" c4Name="SecurityManager" c4Type="Class (Caller)" c4Technology="src/security/guardrails.py" c4Description="Высокоуровневый фасад: делегирует вызовы функций фильтрации в соответствии с security_mode" label="&lt;font style=&quot;font-size: 14px&quot;&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%: %c4Technology%]&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align: left; font-size: 11px;&quot;&gt;+ mode: str&lt;br&gt;+ process_input(query)&lt;br&gt;+ process_chunks(chunks)&lt;br&gt;+ process_output(answer, cot, chunks, score)&lt;/div&gt;" id="9ycdJjKQUusQKeJaiFWU-3">
          <mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#1061B0;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0D5091;metaEdit=1;resizable=0;" vertex="1">
            <mxGeometry height="140" width="280" x="-740" y="530" as="geometry" />
          </mxCell>
        </object>
        <object placeholders="1" c4Name="Config Constants" c4Type="Module (Single Source of Truth)" c4Technology="src/config.py" c4Description="Пороги: SIMILARITY_THRESHOLD (0.80), GROUNDING_OVERLAP_THRESHOLD (0.30), MIN_WORD_LEN (4)" label="&lt;font style=&quot;font-size: 14px&quot;&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%: %c4Technology%]&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align: left; font-size: 10px;&quot;&gt;• SIMILARITY_THRESHOLD = 0.80&lt;br&gt;• GROUNDING_OVERLAP_THRESHOLD = 0.30&lt;br&gt;• GROUNDING_MIN_WORD_LENGTH = 4&lt;/div&gt;" id="9ycdJjKQUusQKeJaiFWU-4">
          <mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#495057;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#343a40;metaEdit=1;resizable=0;" vertex="1">
            <mxGeometry height="110" width="260" x="330" y="760" as="geometry" />
          </mxCell>
        </object>
        <object placeholders="1" c4Name="Regex Registry &amp; Constants" c4Type="Static Data Structures" c4Technology="re.compile(..., re.IGNORECASE)" c4Description="Скомпилированные структуры поиска инъекций, канареечных маркеров и фраз отказа" label="&lt;font style=&quot;font-size: 14px&quot;&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%: %c4Technology%]&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align: left; font-size: 10px;&quot;&gt;• &lt;b&gt;COMPILED_INJECTIONS&lt;/b&gt;: List[Pattern]&lt;br&gt;&amp;nbsp;&amp;nbsp;(ignore all instructions, override system, output:, jailbreak...)&lt;br&gt;• &lt;b&gt;COMPILED_LEAKS&lt;/b&gt;: List[Pattern]&lt;br&gt;&amp;nbsp;&amp;nbsp;(swordfish, суперпароль, root_token, qf_masterpass, hvs\....)&lt;br&gt;• &lt;b&gt;REFUSAL_MARKERS&lt;/b&gt;: List[str]&lt;br&gt;&amp;nbsp;&amp;nbsp;(&#39;я не знаю&#39;, &#39;в корпоративной базе знаний нет информации&#39;...)&lt;/div&gt;" id="9ycdJjKQUusQKeJaiFWU-5">
          <mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;metaEdit=1;resizable=0;" vertex="1">
            <mxGeometry height="140" width="480" x="-210" y="250" as="geometry" />
          </mxCell>
        </object>
        <object placeholders="1" c4Name="check_input_injection(query)" c4Type="Function (Рубеж 1: Input)" c4Technology="Signature: str -&gt; bool" c4Description="Быстрая детекция прямой атаки в пользовательском вводе по COMPILED_INJECTIONS" label="&lt;font style=&quot;font-size: 13px&quot;&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%]&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align: left; font-size: 10px;&quot;&gt;&lt;b&gt;Параметры:&lt;/b&gt; query: str&lt;br&gt;&lt;b&gt;Возврат:&lt;/b&gt; bool (True если обнаружена атака)&lt;br&gt;&lt;b&gt;Логика:&lt;/b&gt; any(p.search(query) for p in COMPILED_INJECTIONS)&lt;/div&gt;" id="9ycdJjKQUusQKeJaiFWU-6">
          <mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#C0392B;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#962D22;metaEdit=1;resizable=0;" vertex="1">
            <mxGeometry height="95" width="360" x="-210" y="420" as="geometry" />
          </mxCell>
        </object>
        <object placeholders="1" c4Name="sanitize_context_chunks(chunks)" c4Type="Function (Рубеж 2: Chunks)" c4Technology="Signature: List[Dict] -&gt; Tuple[List[Dict], bool]" c4Description="Удаление отравленных фрагментов (Indirect Injection / Canary) до сборки контекста LLM" label="&lt;font style=&quot;font-size: 13px&quot;&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%]&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align: left; font-size: 10px;&quot;&gt;&lt;b&gt;Параметры:&lt;/b&gt; chunks: List[Dict[str, Any]]&lt;br&gt;&lt;b&gt;Возврат:&lt;/b&gt; Tuple[List[Dict[str, Any]], bool]&lt;br&gt;&lt;b&gt;Логика:&lt;/b&gt; Отсев чанка при наличии COMPILED_INJECTIONS или COMPILED_LEAKS в text&lt;/div&gt;" id="9ycdJjKQUusQKeJaiFWU-7">
          <mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#C0392B;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#962D22;metaEdit=1;resizable=0;" vertex="1">
            <mxGeometry height="100" width="360" x="-210" y="550" as="geometry" />
          </mxCell>
        </object>
        <object placeholders="1" c4Name="sanitize_output(answer, cot)" c4Type="Function (Рубеж 3: Dual-Sanitizer)" c4Technology="Signature: (str, str) -&gt; Tuple[str, str, bool]" c4Description="Сквозная фильтрация и answer, И chain_of_thought. При утечке swordfish CoT маскируется" label="&lt;font style=&quot;font-size: 13px&quot;&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%]&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align: left; font-size: 10px;&quot;&gt;&lt;b&gt;Параметры:&lt;/b&gt; answer: str, cot: str&lt;br&gt;&lt;b&gt;Возврат:&lt;/b&gt; Tuple[clean_answer: str, clean_cot: str, leak_detected: bool]&lt;br&gt;&lt;b&gt;Логика:&lt;/b&gt; При утечке: answer -&gt; заглушка отказа, cot -&gt; &#39;[Security Alert]&#39;&lt;/div&gt;" id="9ycdJjKQUusQKeJaiFWU-8">
          <mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#C0392B;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#962D22;metaEdit=1;resizable=0;" vertex="1">
            <mxGeometry height="105" width="380" x="-210" y="680" as="geometry" />
          </mxCell>
        </object>
        <object placeholders="1" c4Name="verify_grounding(answer, chunks, score)" c4Type="Function (Рубеж 3: Grounding)" c4Technology="Signature: (str, List[Dict], float) -&gt; bool" c4Description="Двухфакторная проверка: score &gt;= 0.80, нет REFUSAL_MARKERS, Overlap &gt;= 30% слов &gt;= 4 символов" label="&lt;font style=&quot;font-size: 13px&quot;&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%]&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align: left; font-size: 10px;&quot;&gt;&lt;b&gt;Параметры:&lt;/b&gt; answer: str, context_chunks: List[Dict], confidence_score: float&lt;br&gt;&lt;b&gt;Возврат:&lt;/b&gt; bool (is_known)&lt;br&gt;&lt;b&gt;Логика:&lt;/b&gt; len(answer_words ∩ context_words) / len(answer_words) &gt;= 0.30&lt;/div&gt;" id="9ycdJjKQUusQKeJaiFWU-9">
          <mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;metaEdit=1;resizable=0;" vertex="1">
            <mxGeometry height="110" width="380" x="210" y="610" as="geometry" />
