        <object placeholders="1" c4Name="ChromaDB Collection" c4Type="Vector Storage" c4Technology="chroma_db/ (SQLite + Parquet)" c4Description="Персистентное хранилище: векторы d=768, исходный текст чанков, метаданные (source_file, chunk_index)" label="&lt;font style=&quot;font-size: 14px&quot;&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%: %c4Technology%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;&lt;font color=&quot;#cccccc&quot;&gt;%c4Description%&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;" id="jWeDLnjUUn9cUkDF_RPp-2">
          <mxCell parent="1" style="shape=cylinder3;size=15;whiteSpace=wrap;html=1;boundedLbl=1;rounded=0;labelBackgroundColor=none;fillColor=#23A2D9;fontSize=12;fontColor=#ffffff;align=center;strokeColor=#0E7DAD;metaEdit=1;resizable=0;" vertex="1">
            <mxGeometry height="110" width="240" x="1320" y="420" as="geometry" />
          </mxCell>
        </object>
        <object placeholders="1" c4Name="Config" c4Type="Single Source of Truth" c4Technology="src/config.py" c4Description="Параметры: CHROMA_DIR, COLLECTION_NAME, CHUNK_SIZE=800, CHUNK_OVERLAP=150, PASSAGE_PREFIX=&#39;passage: &#39;" label="&lt;font style=&quot;font-size: 13px&quot;&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%: %c4Technology%]&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align: left; font-size: 10px;&quot;&gt;• CHUNK_SIZE = 800&lt;br&gt;• CHUNK_OVERLAP = 150&lt;br&gt;• EMBEDDING_DIM = 768&lt;br&gt;• PASSAGE_PREFIX = &#39;passage: &#39;&lt;/div&gt;" id="jWeDLnjUUn9cUkDF_RPp-3">
          <mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#343a40;metaEdit=1;resizable=0;" vertex="1">
            <mxGeometry height="130" width="250" x="490" y="40" as="geometry" />
          </mxCell>
        </object>
        <object placeholders="1" c4Name="Offline Indexing Pipeline" c4Type="ETL Process" c4Application="src/build_index.py" label="&lt;font style=&quot;font-size: 16px&quot;&gt;&lt;b&gt;&lt;div style=&quot;text-align: left&quot;&gt;%c4Name%&lt;/div&gt;&lt;/b&gt;&lt;/font&gt;&lt;div style=&quot;text-align: left&quot;&gt;[%c4Application%]&lt;/div&gt;" id="jWeDLnjUUn9cUkDF_RPp-4">
          <mxCell parent="1" style="rounded=1;fontSize=11;whiteSpace=wrap;html=1;dashed=1;arcSize=15;fillColor=none;strokeColor=#666666;fontColor=#333333;labelBackgroundColor=none;align=left;verticalAlign=bottom;spacingTop=0;spacing=10;dashPattern=8 4;metaEdit=1;pointerEvents=0;absoluteArcSize=1;" vertex="1">
            <mxGeometry height="670" width="800" x="340" y="210" as="geometry" />
          </mxCell>
        </object>
        <object placeholders="1" c4Name="1. Document Loader &amp; Splitter" c4Type="ETL Step" c4Technology="RecursiveCharacterTextSplitter" c4Description="Чтение .txt, разбиение на чанки (800 символов, перекрытие 150), генерация сквозного chunk_id и метаданных" label="&lt;font style=&quot;font-size: 13px&quot;&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%: %c4Technology%]&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align: left; font-size: 10px;&quot;&gt;• separators=[&#39;\n\n&#39;, &#39;\n&#39;, &#39; &#39;, &#39;&#39;]&lt;br&gt;• chunk_size=800, overlap=150&lt;br&gt;• генерация List[Dict] с source_file&lt;/div&gt;" id="jWeDLnjUUn9cUkDF_RPp-5">
          <mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;metaEdit=1;resizable=0;" vertex="1">
            <mxGeometry height="110" width="240" x="380" y="260" as="geometry" />
          </mxCell>
        </object>
        <object placeholders="1" c4Name="2. Batch Vector Encoding" c4Type="ETL Step" c4Technology="intfloat/multilingual-e5-base" c4Description="Добавление префикса &#39;passage: &#39;, расчет плотных эмбеддингов (d=768) батчами по 32 и L2-нормализация" label="&lt;font style=&quot;font-size: 13px&quot;&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%: %c4Technology%]&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align: left; font-size: 10px;&quot;&gt;• texts = [&#39;passage: &#39; + t for t in texts]&lt;br&gt;• model.encode(batch_size=32)&lt;br&gt;• numpy array (N_chunks, 768, float32)&lt;/div&gt;" id="jWeDLnjUUn9cUkDF_RPp-6">
          <mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;metaEdit=1;resizable=0;" vertex="1">
            <mxGeometry height="110" width="240" x="690" y="260" as="geometry" />
          </mxCell>
        </object>
        <object placeholders="1" c4Name="3. Collection Persisting" c4Type="ETL Step" c4Technology="collection.add()" c4Description="Пакетная запись эмбеддингов, оригинального текста документов, id и метаданных в ChromaDB" label="&lt;font style=&quot;font-size: 13px&quot;&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%: %c4Technology%]&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align: left; font-size: 10px;&quot;&gt;• collection.add(&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ids=ids, embeddings=embeddings,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;documents=texts, metadatas=meta&lt;br&gt;&amp;nbsp;&amp;nbsp;)&lt;/div&gt;" id="jWeDLnjUUn9cUkDF_RPp-7">
          <mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;metaEdit=1;resizable=0;" vertex="1">
            <mxGeometry height="110" width="240" x="870" y="420" as="geometry" />
          </mxCell>
        </object>
        <object placeholders="1" c4Name="4. Index Verification (Smoke Test)" c4Type="Validation Step" c4Technology="collection.query(k=3)" c4Description="Контрольный семантический запрос с префиксом &#39;query: &#39; для проверки корректности векторов и доступности коллекции" label="&lt;font style=&quot;font-size: 13px&quot;&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%: %c4Technology%]&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align: left; font-size: 10px;&quot;&gt;• Тестовый запрос: &#39;query: ...&#39;&lt;br&gt;• Проверка скоров сходства (&gt;= 0.80)&lt;br&gt;• Вывод контрольных сниппетов в консоль&lt;/div&gt;" id="jWeDLnjUUn9cUkDF_RPp-8">
          <mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#28A745;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#1E7E34;metaEdit=1;resizable=0;" vertex="1">
