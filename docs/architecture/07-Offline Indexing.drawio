        <object placeholders="1" c4Name="Корпус базы знаний" c4Type="Data Storage" c4Technology="data/knowledge_base/" c4Description="30+ нормализованных текстовых файлов (.txt) предметной области Aetheria" label="&lt;font style=&quot;font-size: 14px&quot;&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%: %c4Technology%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;&lt;font color=&quot;#cccccc&quot;&gt;%c4Description%&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;" id="jWeDLnjUUn9cUkDF_RPp-1">
